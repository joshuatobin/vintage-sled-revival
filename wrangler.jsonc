{
  "name": "vintage-sled-revival",
  "main": "worker/index.mjs",
  "keep_vars": true,
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GARAGE", "class_name": "GarageStore" }]
  },
  "migrations": [{ "tag": "v1-garage", "new_sqlite_classes": ["GarageStore"] }]
}
